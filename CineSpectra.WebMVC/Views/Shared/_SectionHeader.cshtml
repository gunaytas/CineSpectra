@model dynamic
@*
    Kullanım:
    @await Html.PartialAsync("_SectionHeader", new {
        Eyebrow  = "Topluluk Favorileri",
        Headline = "Öne Çıkan Yapımlar",
        Subtitle = "CineSpectra topluluğunun en yüksek puan verdiği yapımlar" // opsiyonel, null geçilebilir
    })
*@
<div class="mb-8 relative">
    <p class="cs-eyebrow uppercase mb-2">@Model.Eyebrow</p>
    <h2 class="cs-headline text-3xl font-bold italic">@Model.Headline</h2>
    @if (Model.Subtitle != null)
    {
        <p class="text-sm mt-1 cs-muted">@Model.Subtitle</p>
    }
</div>
