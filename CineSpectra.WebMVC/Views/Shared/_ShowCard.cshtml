@model dynamic
@*
    Kullanım (show: Id, Title, CoverImageUrl, AverageScore, ReleaseDate, Type alanlarına sahip olmalı):
    @await Html.PartialAsync("_ShowCard", show)

    Not: Model burada bilinçli olarak `dynamic` — Popüler/Yeni/Tür listelerindeki
    öge tipleri muhtemelen aynı alanlara sahip ama farklı sınıflar olabilir.
    Projede tek bir ortak "ShowCardViewModel" tipiniz varsa, bunu güçlü tipe
    çevirip (@@model CineSpectra.WebMVC.Models.ShowCardViewModel) derleme
    zamanı güvenliği kazanabilirsiniz.
*@
<div class="cs-card group relative rounded-2xl overflow-hidden">
    <div class="cs-poster relative aspect-[2/3] w-full overflow-hidden">
        <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/default-poster.jpg" : Model.CoverImageUrl)" alt="@Model.Title"
             class="h-full w-full object-cover" loading="lazy" />
        <div class="cs-score absolute top-3 left-3 text-xs px-2.5 py-1 rounded-lg backdrop-blur-sm flex items-center gap-1">
            <i class="fa-solid fa-star"></i> @Model.AverageScore.ToString("0.0")
        </div>
    </div>
    <div class="p-4">
        <h3 class="font-bold text-sm line-clamp-1 transition-colors" style="color: var(--ivory);">
            <a href="/Shows/@Model.Id" class="hover:opacity-80">@Model.Title</a>
        </h3>
        <p class="cs-type-pill text-xs mt-2 cs-muted">
            @(Model.ReleaseDate?.Year.ToString() ?? "N/A") &bull; @(Model.Type == 2 ? "Dizi" : "Film")
        </p>
    </div>
</div>
