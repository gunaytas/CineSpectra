@using CineSpectra.Domain.Enums

@model CineSpectra.Application.DTOs.ShowListDto

@if (Model == null)
{
    return;
}

<div class="cs-card group relative rounded-2xl overflow-hidden flex flex-col">
    <a href="/Shows/@Model.Id" class="cs-poster relative aspect-[2/3] w-full overflow-hidden block">
        <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/default-poster.jpg" : Model.CoverImageUrl)"
             alt="@Model.Title"
             class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />

        <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
            @if (Model.Type == MediaType.TVShow)
            {
                @* Kriter Puanı *@
                <div class="cs-score text-[11px] px-2 py-0.5 rounded-md backdrop-blur-md flex items-center gap-1">
                    <i class="fa-solid fa-sliders text-[10px]"></i>
                    <span>@Model.AverageScore.ToString("0.0")</span>
                </div>
                @* Bölüm Puanı *@
                <div class="text-[11px] px-2 py-0.5 rounded-md backdrop-blur-md flex items-center gap-1 font-bold"
                     style="background: rgba(36, 25, 34, 0.85); border: 1px solid #4A3444; color: var(--ivory);">
                    <i class="fa-solid fa-tv text-[10px]" style="color: var(--mauve);"></i>
                    <span>@(Model.EpisodeAudienceScore.HasValue && Model.EpisodeAudienceScore > 0 ? Model.EpisodeAudienceScore.Value.ToString("0.0") : "—")</span>
                </div>
            }
            else
            {
                <div class="cs-score text-xs px-2.5 py-1 rounded-lg backdrop-blur-md flex items-center gap-1">
                    <i class="fa-solid fa-star text-[11px]"></i>
                    <span>@Model.AverageScore.ToString("0.0")</span>
                </div>
            }
        </div>
    </a>

    <div class="p-4 flex flex-col flex-grow justify-between gap-2">
        <a href="/Shows/@Model.Id" class="font-bold text-sm line-clamp-1 hover:text-[#F0B23C] transition-colors" style="color: var(--ivory);">
            @Model.Title
        </a>
        <div class="flex items-center justify-between text-xs cs-muted">
            <span>@(Model.ReleaseDate?.Year.ToString() ?? "—")</span>
            <span class="cs-pill text-[10px] px-2 py-0.5 rounded-full">
                @(Model.Type == MediaType.TVShow ? "Dizi" : "Film")
            </span>
        </div>
    </div>
</div>