@using CineSpectra.Domain.Enums
@model CineSpectra.WebMVC.Models.HomeViewModel

@{
    ViewData["Title"] = "Keşfet & Puanla";
}

@if (Model.HeroShow != null)
{
    <section class="cs-hero min-h-[560px] w-full overflow-hidden flex items-center py-16">
        <div class="cs-hero-media" style="background-image: url('@(string.IsNullOrEmpty(Model.HeroShow.CoverImageUrl) ? "/images/default-hero.jpg" : Model.HeroShow.CoverImageUrl)'); filter: saturate(1.08) contrast(1.05) blur(6px); transform: scale(1.04);"></div>
        <div class="cs-hero-grade"></div>
        <div class="cs-hero-grain"></div>
        <div class="cs-hero-scrim-b"></div>
        <div class="cs-hero-scrim-r"></div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10">
            <div class="flex flex-col md:flex-row items-center md:items-end justify-between gap-10 md:gap-12">

                <div class="max-w-2xl">
                    <div class="flex items-center mb-4">
                        <span class="cs-bulbs"><span></span><span></span><span></span><span></span></span>
                        
                    </div>
                    <h1 class="cs-headline text-4xl sm:text-6xl font-extrabold italic tracking-tight mb-4 leading-[1.05]">
                        @Model.HeroShow.Title
                    </h1>
                    <p class="text-sm sm:text-base line-clamp-3 mb-8 leading-relaxed cs-muted">
                        @Model.HeroShow.Description
                    </p>
                    <div class="flex items-center gap-4 flex-wrap">
                        <a href="/Shows/@Model.HeroShow.Id" class="cs-btn-primary text-sm font-bold px-6 py-3 rounded-xl flex items-center gap-2">
                            <i class="fa-solid fa-circle-info"></i> Detayları Gör
                        </a>
                        <div class="flex items-center gap-3 flex-wrap pt-4">
                            @if (Model.HeroShow.Type == MediaType.TVShow)
                            {
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <a href="/Shows/@Model.HeroShow.Id/Rate" class="cs-btn-primary text-xs font-bold px-5 py-3 rounded-xl flex items-center gap-2">
                                        <i class="fa-solid fa-sliders"></i> Kriter Puanla
                                    </a>
                                    <a href="/Shows/@Model.HeroShow.Id/RateEpisode" class="cs-btn-ghost text-xs font-bold px-5 py-3 rounded-xl flex items-center gap-2">
                                        <i class="fa-solid fa-tv" style="color: var(--gold);"></i> Bölüm Puanla
                                    </a>
                                }
                                else
                                {
                                    <div class="flex flex-col items-start sm:items-center gap-1.5">
                                        <a href="/Account/Login?returnUrl=@Url.Action("Rate", "Shows", new { id = Model.HeroShow.Id })"
                                           class="cs-btn-primary text-sm font-bold px-6 py-2.5 rounded-xl flex items-center gap-2 shadow-lg hover:scale-105 transition-transform">
                                            <i class="fa-solid fa-right-to-bracket"></i> Puanlamak İçin Giriş Yap
                                        </a>
                                        <span class="text-[11px] cs-muted flex items-center gap-1.5 pl-1" style="color: var(--mauve);">
                                            <i class="fa-solid fa-lock text-[10px]" style="color: var(--gold);"></i>
                                            Puan verebilmek ve inceleme yazabilmek için oturum açmalısınız.
                                        </span>
                                    </div>
                                }

                            }
                            else
                            {
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <a href="/Shows/@Model.HeroShow.Id/Rate" class="cs-btn-primary text-sm font-bold px-6 py-3 rounded-xl flex items-center gap-2">
                                        <i class="fa-solid fa-star"></i> Şimdi Puanla
                                    </a>
                                }
                                else
                                {
                                    <div class="flex flex-col items-start sm:items-center gap-1.5">
                                        <a href="/Account/Login?returnUrl=@Url.Action("Rate", "Shows", new { id = Model.HeroShow.Id })"
                                           class="cs-btn-primary text-sm font-bold px-6 py-2.5 rounded-xl flex items-center gap-2 shadow-lg hover:scale-105 transition-transform">
                                            <i class="fa-solid fa-right-to-bracket"></i> Puanlamak İçin Giriş Yap
                                        </a>
                                        <span class="text-[11px] cs-muted flex items-center gap-1.5 pl-1" style="color: var(--mauve);">
                                            <i class="fa-solid fa-lock text-[10px]" style="color: var(--gold);"></i>
                                            Puan verebilmek ve inceleme yazabilmek için oturum açmalısınız.
                                        </span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <a href="/Shows/@Model.HeroShow.Id" class="cs-card hidden sm:block flex-shrink-0 relative w-56 md:w-64 aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl">
                    <img src="@(string.IsNullOrEmpty(Model.HeroShow.CoverImageUrl) ? "/images/default-poster.jpg" : Model.HeroShow.CoverImageUrl)"
                         alt="@Model.HeroShow.Title" class="h-full w-full object-cover" />
                    <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
                        @if (Model.HeroShow.Type == MediaType.TVShow)
                        {
                            @* Kriter Puanı *@
                            <div class="cs-score text-[11px] px-2 py-0.5 rounded-md backdrop-blur-md flex items-center gap-1">
                                <i class="fa-solid fa-sliders text-[10px]"></i>
                                <span>@Model.HeroShow.AverageScore.ToString("0.0")</span>
                            </div>
                            @* Bölüm Puanı *@
                            <div class="text-[11px] px-2 py-0.5 rounded-md backdrop-blur-md flex items-center gap-1 font-bold"
                                 style="background: rgba(36, 25, 34, 0.85); border: 1px solid #4A3444; color: var(--ivory);">
                                <i class="fa-solid fa-tv text-[10px]" style="color: var(--mauve);"></i>
                                <span>@(Model.HeroShow.EpisodeAudienceScore.HasValue && Model.HeroShow.EpisodeAudienceScore > 0 ? Model.HeroShow.EpisodeAudienceScore.Value.ToString("0.0") : "—")</span>
                            </div>
                        }
                        else
                        {
                            <div class="cs-score text-xs px-2.5 py-1 rounded-lg backdrop-blur-md flex items-center gap-1">
                                <i class="fa-solid fa-star text-[11px]"></i>
                                <span>@Model.HeroShow.AverageScore.ToString("0.0")</span>
                            </div>
                        }
                    </div>
                </a>

            </div>
        </div>
    </section>
    <div class="cs-sprocket"></div>
}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-8 relative">
    <div class="cs-glow" style="top: -120px; right: -200px;"></div>

    @* 1. Öne Çıkan Yapımlar *@
    <section class="relative">
        @await Html.PartialAsync("_SectionHeader", new
        {
            Eyebrow = default(string),
                Headline = "Öne Çıkan Yapımlar",
                Subtitle = "CineSpectra topluluğunun en yüksek puan verdiği yapımlar"
                })

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @if (Model.PopularShows != null && Model.PopularShows.Any())
            {
                @foreach (var show in Model.PopularShows.Where(s => s != null))
                {
                    @await Html.PartialAsync("_ShowCard", show)
                }
            }
            else
            {
                <div class="col-span-full py-8 text-center text-sm cs-muted">
                    Öne çıkan yapım bulunamadı.
                </div>
            }
        </div>
    </section>

    <div class="cs-sprocket !my-14"></div>

    @* 2. Yeni Eklenenler *@
    <section>
        @await Html.PartialAsync("_SectionHeader", new
        {
            Eyebrow = default(string),
                Headline = "Yeni Eklenenler",
                Subtitle = "Sisteme yeni eklenen ve vizyona giren güncel yapımlar"
                })

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @if (Model.RecentShows != null && Model.RecentShows.Any())
            {
                @foreach (var show in Model.RecentShows.Where(s => s != null).Take(5))
                {
                    @await Html.PartialAsync("_ShowCard", show)
                }
            }
            else
            {
                <div class="col-span-full py-8 text-center text-sm cs-muted">
                    Yeni eklenen yapım bulunamadı.
                </div>
            }
        </div>
    </section>

    @* 3. Tür Grupları *@
    @if (Model.GenreGroups != null && Model.GenreGroups.Any())
    {
        @foreach (var group in Model.GenreGroups.Where(g => g != null && g.Shows != null && g.Shows.Any()))
        {
            <div class="cs-sprocket !my-14"></div>

            <section>
                @await Html.PartialAsync("_SectionHeader", new
                {
                    Eyebrow = default(string),
                Headline = $"{group.GenreName} Yapımları",
                Subtitle = default(string)
                })

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @foreach (var show in group.Shows.Where(s => s != null))
                    {
                        @await Html.PartialAsync("_ShowCard", show)
                    }
                </div>
            </section>
        }
    }
</div>
