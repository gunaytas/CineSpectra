@model List<CineSpectra.Application.DTOs.ShowListDto>

@{
    ViewData["Title"] = "Filmler Arşivi";
    string currentSort = ViewBag.CurrentSort as string ?? "top-rated";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

    @* 1. Tepe Başlık & Filtre Çubuğu *@
    <div class="cs-panel rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6"
         style="background: radial-gradient(120% 120% at 50% 0%, #2A1D26 0%, var(--velvet) 100%); border: 1px solid #3A2A38;">

        <div class="space-y-1 text-center md:text-left">
            <span class="cs-eyebrow tracking-widest text-xs uppercase block">CINESPECTRA ARŞİVİ</span>
            <h1 class="text-2xl sm:text-4xl font-extrabold italic" style="color: var(--ivory);">
                <i class="fa-solid fa-film text-xl mr-2" style="color: var(--gold);"></i>Filmler
            </h1>
            <p class="text-xs cs-muted">
                Sinema dünyasından en beğenilen, ödüllü ve yeni yapımları keşfedin.
            </p>
        </div>

        @* Sıralama Butonları *@
        <div class="flex items-center gap-2 flex-wrap justify-center">
            <a href="/shows/movies?sortBy=top-rated"
               class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(currentSort == "top-rated" ? "scale-105 shadow-md" : "opacity-70 hover:opacity-100")"
               style="background: @(currentSort == "top-rated" ? "var(--gold)" : "var(--curtain)"); color: @(currentSort == "top-rated" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                <i class="fa-solid fa-star text-[10px] mr-1"></i> En Yüksek Puanlılar
            </a>

            <a href="/shows/movies?sortBy=newest"
               class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(currentSort == "newest" ? "scale-105 shadow-md" : "opacity-70 hover:opacity-100")"
               style="background: @(currentSort == "newest" ? "var(--gold)" : "var(--curtain)"); color: @(currentSort == "newest" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                <i class="fa-solid fa-clock text-[10px] mr-1"></i> En Yeniler
            </a>

            <a href="/shows/movies?sortBy=title"
               class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(currentSort == "title" ? "scale-105 shadow-md" : "opacity-70 hover:opacity-100")"
               style="background: @(currentSort == "title" ? "var(--gold)" : "var(--curtain)"); color: @(currentSort == "title" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                <i class="fa-solid fa-arrow-down-a-z text-[10px] mr-1"></i> Alfabetik
            </a>
        </div>
    </div>

    @* 2. Film Sayacı & Bilgilendirme *@
    <div class="flex items-center justify-between border-b pb-3" style="border-color: #3A2A38;">
        <span class="text-xs font-semibold cs-muted">
            Toplam <strong style="color: var(--gold);">@(Model?.Count ?? 0)</strong> film listeleniyor
        </span>
    </div>

    @* 3. Film Kartları Izgarası *@
    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @foreach (var movie in Model)
            {
                @await Html.PartialAsync("_ShowCard", movie)
            }
        </div>
    }
    else
    {
        <div class="cs-panel rounded-3xl p-16 text-center space-y-3" style="border: 1px dashed #3A2A38;">
            <i class="fa-solid fa-film-slash text-4xl cs-muted mb-2"></i>
            <h3 class="text-lg font-bold" style="color: var(--ivory);">Henüz film kaydı bulunmuyor</h3>
            <p class="text-xs cs-muted max-w-sm mx-auto">
                Veritabanında listelenebilecek film verisi bulunamadı. Yeni yapımlar eklendiğinde burada görünecektir.
            </p>
        </div>
    }

</div>