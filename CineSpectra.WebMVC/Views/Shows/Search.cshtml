@using CineSpectra.Domain.Enums
@model CineSpectra.WebMVC.Models.SearchViewModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query)
        ? "Keşfet ve Ara"
        : $"'{Model.Query}' - Arama Sonuçları";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

    @* 1. Arama Başlığı ve Arama Kutusu *@
    <div class="cs-panel rounded-3xl p-6 sm:p-10 text-center space-y-6" style="background: radial-gradient(120% 120% at 50% 0%, #2A1D26 0%, var(--velvet) 100%); border: 1px solid #3A2A38;">
        <div>
            <span class="cs-eyebrow tracking-widest text-xs uppercase block mb-1">CINESPECTRA DİZİNİ</span>
            <h1 class="text-2xl sm:text-4xl font-extrabold italic" style="color: var(--ivory);">
                Yapım, Oyuncu ve Karakter Keşfi
            </h1>
        </div>

        <form method="get" action="/shows/search" class="max-w-2xl mx-auto flex flex-col sm:flex-row items-center gap-3">
            <div class="relative w-full">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-sm cs-muted"></i>
                <input type="text"
                       name="q"
                       value="@Model.Query"
                       placeholder="Film, dizi, oyuncu veya karakter adı..."
                       autocomplete="off"
                       class="w-full pl-11 pr-4 py-3.5 rounded-2xl text-sm focus:outline-none focus:border-amber-400 transition-colors"
                       style="background: #170F15; border: 1px solid #3A2A38; color: var(--ivory);" />
            </div>
            <input type="hidden" name="tab" value="@Model.ActiveTab" />

            <button type="submit"
                    class="cs-btn-primary w-full sm:w-auto px-8 py-3.5 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 whitespace-nowrap shadow-lg">
                <i class="fa-solid fa-magnifying-glass text-xs"></i>
                <span>Ara</span>
            </button>
        </form>

        @* Sekme Filtreleri (Tümü / Yapımlar / Oyuncular / Karakterler) *@
        <div class="flex items-center justify-center gap-2 pt-2 flex-wrap">
            <a href="/shows/search?q=@Model.Query&tab=all"
               class="px-4 py-1.5 rounded-full text-xs font-semibold transition-all @(Model.ActiveTab == "all" ? "scale-105" : "opacity-60")"
               style="background: @(Model.ActiveTab == "all" ? "var(--gold)" : "var(--curtain)"); color: @(Model.ActiveTab == "all" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                Tümü (@Model.TotalCount)
            </a>
            <a href="/shows/search?q=@Model.Query&tab=shows"
               class="px-4 py-1.5 rounded-full text-xs font-semibold transition-all @(Model.ActiveTab == "shows" ? "scale-105" : "opacity-60")"
               style="background: @(Model.ActiveTab == "shows" ? "var(--gold)" : "var(--curtain)"); color: @(Model.ActiveTab == "shows" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                <i class="fa-solid fa-film text-[10px] mr-1"></i> Yapımlar (@Model.Shows.Count)
            </a>
            <a href="/shows/search?q=@Model.Query&tab=actors"
               class="px-4 py-1.5 rounded-full text-xs font-semibold transition-all @(Model.ActiveTab == "actors" ? "scale-105" : "opacity-60")"
               style="background: @(Model.ActiveTab == "actors" ? "var(--gold)" : "var(--curtain)"); color: @(Model.ActiveTab == "actors" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                <i class="fa-solid fa-user text-[10px] mr-1"></i> Oyuncular (@Model.Actors.Count)
            </a>
            <a href="/shows/search?q=@Model.Query&tab=characters"
               class="px-4 py-1.5 rounded-full text-xs font-semibold transition-all @(Model.ActiveTab == "characters" ? "scale-105" : "opacity-60")"
               style="background: @(Model.ActiveTab == "characters" ? "var(--gold)" : "var(--curtain)"); color: @(Model.ActiveTab == "characters" ? "var(--velvet)" : "var(--ivory)"); border: 1px solid #3A2A38;">
                <i class="fa-solid fa-masks-theater text-[10px] mr-1"></i> Karakterler (@Model.Characters.Count)
            </a>
        </div>
    </div>

    @* 2. Sonuç Listesi *@
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        @if (Model.TotalCount == 0)
        {
            <div class="cs-panel rounded-3xl p-12 text-center space-y-3" style="border: 1px dashed #3A2A38;">
                <i class="fa-solid fa-magnifying-glass text-4xl cs-muted mb-2"></i>
                <h3 class="text-lg font-bold" style="color: var(--ivory);">Eşleşen sonuç bulunamadı</h3>
                <p class="text-xs cs-muted max-w-sm mx-auto">
                    "@Model.Query" ifadesiyle eşleşen yapım, oyuncu veya karakter kaydı yer almıyor.
                </p>
            </div>
        }
        else
        {
            @* A) Yapımlar Bölümü *@
            @if ((Model.ActiveTab == "all" || Model.ActiveTab == "shows") && Model.Shows.Any())
            {
                <section class="space-y-4">
                    <h2 class="text-lg font-bold flex items-center gap-2" style="color: var(--ivory);">
                        <i class="fa-solid fa-film text-sm" style="color: var(--gold);"></i> Yapımlar
                    </h2>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
                        @foreach (var show in Model.Shows)
                        {
                            @await Html.PartialAsync("_ShowCard", show)
                        }
                    </div>
                </section>
            }

            @* B) Oyuncular Bölümü *@
            @if ((Model.ActiveTab == "all" || Model.ActiveTab == "actors") && Model.Actors.Any())
            {
                <section class="space-y-4">
                    <h2 class="text-lg font-bold flex items-center gap-2" style="color: var(--ivory);">
                        <i class="fa-solid fa-user text-sm" style="color: var(--gold);"></i> Oyuncular
                    </h2>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
                        @foreach (var actor in Model.Actors)
                        {
                            <div class="cs-card group rounded-2xl overflow-hidden p-3 space-y-2 text-center">
                                <div class="relative aspect-[3/4] w-full rounded-xl overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(actor.ProfileImageUrl) ? "/images/default-avatar.jpg" : actor.ProfileImageUrl)"
                                         alt="@actor.Name" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />

                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                                         style="background: #150F13dd;">
                                        <a href="/Actors/@actor.Id" class="cs-btn-primary text-xs font-bold py-1.5 px-4 rounded-lg">
                                            Profili Gör
                                        </a>
                                    </div>
                                </div>
                                <h3 class="font-bold text-sm line-clamp-1" style="color: var(--ivory);">@actor.Name</h3>
                            </div>
                        }
                    </div>
                </section>
            }

            @* C) Karakterler Bölümü *@
            @if ((Model.ActiveTab == "all" || Model.ActiveTab == "characters") && Model.Characters.Any())
            {
                <section class="space-y-4">
                    <h2 class="text-lg font-bold flex items-center gap-2" style="color: var(--ivory);">
                        <i class="fa-solid fa-masks-theater text-sm" style="color: var(--gold);"></i> Karakterler
                    </h2>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
                        @foreach (var character in Model.Characters)
                        {
                            <div class="cs-card group rounded-2xl overflow-hidden p-3 space-y-2 text-center">
                                <div class="relative aspect-[3/4] w-full rounded-xl overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(character.ImageUrl) ? "/images/default-avatar.jpg" : character.ImageUrl)"
                                         alt="@character.Name" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />

                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                                         style="background: #150F13dd;">
                                        <a href="/Characters/@character.Id" class="cs-btn-primary text-xs font-bold py-1.5 px-4 rounded-lg">
                                            İncele
                                        </a>
                                    </div>
                                </div>
                                <div>
                                    <h3 class="font-bold text-sm line-clamp-1" style="color: var(--ivory);">@character.Name</h3>
                                    @if (!string.IsNullOrEmpty(character.ActorName))
                                    {
                                        <p class="text-[11px] cs-muted line-clamp-1 mt-0.5">@character.ActorName</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    }
    else
    {
        <div class="cs-panel rounded-3xl p-12 text-center space-y-2" style="border: 1px solid #3A2A38;">
            <i class="fa-solid fa-clapperboard text-3xl cs-muted mb-2"></i>
            <p class="text-sm cs-muted">
                Aramak istediğiniz yapım, oyuncu veya karakter adını yukarıdaki alana yazarak sonuçları görüntüleyebilirsiniz.
            </p>
        </div>
    }
</div>